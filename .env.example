VITE_SUPABASE_PROJECT_ID=tu_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=tu_anon_key
VITE_SUPABASE_URL=https://tu_project_id.supabase.co

# OpenRouter — LLM Interpreter (server-side, NO exponer al cliente)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: modelos de OpenRouter separados por comas, en orden de preferencia
# (por defecto se usan modelos gratuitos; para clientes se recomiendan modelos de pago)
LLM_MODELS=
# Opcional: dominios propios adicionales que pueden usar /api/llm-interpret
ALLOWED_ORIGINS=
